{
  "name": "access-control",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/access-control/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/access-control",
        "main": "libs/access-control/src/index.ts",
        "tsConfig": "libs/access-control/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/access-control/jest.config.ts"
      }
    }
  },
  "tags": ["type:lib", "scope:shared"]
}
