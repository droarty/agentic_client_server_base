{
  "name": "workflow-configs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/workflow-configs/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/workflow-configs",
        "main": "libs/workflow-configs/src/index.ts",
        "tsConfig": "libs/workflow-configs/tsconfig.lib.json",
        "assets": [
          { "glob": "**/*.json", "input": "libs/workflow-configs/src/workflows", "output": "workflows" }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/workflow-configs/jest.config.ts"
      }
    }
  },
  "tags": ["type:lib", "scope:shared"]
}
