NODE_ENV=development
REDIS_URL=redis://localhost:6379
PORT=3000

# Postgres — matches docker-compose.yml's local postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentic_client_server_base

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
CLIENT_URL=http://localhost:4200

# event-processor service
PROCESSOR_PORT=3001
EVENT_PROCESSOR_URL=http://localhost:3001

# Shared secret authenticating the gateway's calls to the event-processor's
# POST /internal/events. Must be set to the SAME value on both apps/api and
# apps/event-processor — an empty value is refused at boot in production.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value

# Google OAuth 2.0
# Create credentials at https://console.developers.google.com
# Under APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Set Authorised redirect URI to: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Google Photos Picker (separate consent from login OAuth above — reuses the
# same GOOGLE_CLIENT_ID/SECRET, requests the photospicker scope instead)
# Also add this redirect URI under the same OAuth 2.0 Client ID in the console.
GOOGLE_PHOTOS_CALLBACK_URL=http://localhost:3000/api/google-photos/callback
