NODE_ENV=development
REDIS_URL=redis://localhost:6379
PORT=3000

# Postgres — matches docker-compose.yml's local postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentic_client_server_base

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
CLIENT_URL=http://localhost:4200

# event-processor service
PROCESSOR_PORT=3001
EVENT_PROCESSOR_URL=http://localhost:3001

# AI provider used by the `ai` workflow step. AI_SERVICE_TYPE selects which
# key is required — set only the matching key.
AI_SERVICE_TYPE=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Shared secret authenticating the gateway's calls to the event-processor's
# POST /internal/events. Must be set to the SAME value on both apps/api and
# apps/event-processor — an empty value is refused at boot in production.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value

# Google OAuth 2.0
# Create credentials at https://console.developers.google.com
# Under APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Set Authorised redirect URI to: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Google Photos Picker (separate consent from login OAuth above — reuses the
# same GOOGLE_CLIENT_ID/SECRET, requests the photospicker scope instead)
# Also add this redirect URI under the same OAuth 2.0 Client ID in the console.
GOOGLE_PHOTOS_CALLBACK_URL=http://localhost:3000/api/google-photos/callback

# Object storage (Cloudflare R2)
# wrangler-dev = local dev, routed through apps/r2-dev-gateway (wrangler dev on :8787)
# r2           = real Cloudflare R2 S3-compatible endpoint (staging/prod)
STORAGE_BACKEND=wrangler-dev
R2_DEV_GATEWAY_URL=http://localhost:8787

# Only required when STORAGE_BACKEND=r2 — from Cloudflare dashboard: R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
