{
  "name": "event-processor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/event-processor/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/event-processor",
        "format": ["cjs"],
        "bundle": true,
        "main": "apps/event-processor/src/main.ts",
        "tsConfig": "apps/event-processor/tsconfig.app.json",
        "assets": [
          { "glob": ".env", "input": "apps/event-processor", "output": "." },
          { "glob": "**/*", "input": "docs/workflow-reference", "output": "docs/workflow-reference" }
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": { ".js": ".js" }
        }
      },
      "configurations": {
        "development": {
          "minify": false,
          "sourcemap": true
        },
        "production": {
          "minify": true,
          "sourcemap": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/event-processor/tsconfig.app.json nodemon --watch 'apps/event-processor/src/**/*.ts' --exec 'node -r ts-node/register -r tsconfig-paths/register apps/event-processor/src/main.ts'"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/event-processor/jest.config.ts"
      }
    }
  },
  "tags": ["type:app", "scope:event-processor"]
}
